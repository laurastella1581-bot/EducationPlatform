import React, { useState, useEffect } from 'react';
import { 
  Heart, 
  BookOpen, 
  Send, 
  Sparkles, 
  ChevronRight, 
  History, 
  User, 
  Compass,
  ShieldCheck,
  Star,
  ArrowLeft,
  Trash2,
  Palette,
  CloudRain,
  Flame,
  CloudMoon,
  Sun,
  Ghost
} from 'lucide-react';
import { initializeApp } from 'firebase/app';
import { 
  getFirestore, 
  collection, 
  doc, 
  addDoc, 
  onSnapshot, 
  deleteDoc,
  query,
  orderBy
} from 'firebase/firestore';
import { 
  getAuth, 
  signInAnonymously, 
  signInWithCustomToken, 
  onAuthStateChanged 
} from 'firebase/auth';

// --- Firebase Configuration ---
const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'wise-diary-v3';

// 아이들이 좋아하는 8가지 감정 스티커
const EMOTIONS = [
  { id: 'happy', emoji: '🌟', label: '최고', color: 'bg-yellow-100', text: 'text-yellow-600' },
  { id: 'sad', emoji: '😭', label: '눈물', color: 'bg-blue-100', text: 'text-blue-600' },
  { id: 'angry', emoji: '🔥', label: '화나', color: 'bg-red-100', text: 'text-red-600' },
  { id: 'lonely', emoji: '☁️', label: '외로워', color: 'bg-slate-100', text: 'text-slate-600' },
  { id: 'scared', emoji: '👻', label: '무셔', color: 'bg-purple-100', text: 'text-purple-600' },
  { id: 'excited', emoji: '🥳', label: '신나', color: 'bg-orange-100', text: 'text-orange-600' },
  { id: 'tired', emoji: '😴', label: '피곤', color: 'bg-green-100', text: 'text-green-600' },
  { id: 'love', emoji: '💖', label: '사랑', color: 'bg-pink-100', text: 'text-pink-600' },
];

const App = () => {
  const [user, setUser] = useState(null);
  const [entries, setEntries] = useState([]);
  const [diaryText, setDiaryText] = useState('');
  const [selectedEmotion, setSelectedEmotion] = useState(EMOTIONS[0].id);
  const [isGenerating, setIsGenerating] = useState(false);
  const [view, setView] = useState('write'); 
  const [currentEntry, setCurrentEntry] = useState(null);
  const [error, setError] = useState(null);

  const apiKey = ""; 

  // --- Auth Setup ---
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Auth error:", err);
        setError("인증에 실패했습니다.");
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  // --- Data Fetching ---
  useEffect(() => {
    if (!user) return;

    const q = collection(db, 'artifacts', appId, 'users', user.uid, 'diary_entries');
    const unsubscribe = onSnapshot(q, (snapshot) => {
      const data = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      const sortedData = data.sort((a, b) => (b.timestamp?.seconds || 0) - (a.timestamp?.seconds || 0));
      setEntries(sortedData);
    }, (err) => {
      console.error("Firestore error:", err);
      setError("비밀 서랍을 열지 못했어요.");
    });

    return () => unsubscribe();
  }, [user]);

  // --- AI Logic ---
  const generateResponse = async (content) => {
    if (!content.trim()) return;
    setIsGenerating(true);
    setError(null);

    const emotionLabel = EMOTIONS.find(e => e.id === selectedEmotion)?.label;

    const systemInstruction = `
      당신은 아이의 소중한 마음을 들어주는 따뜻한 멘토 '마음의 등불'입니다.
      아이의 감정(${emotionLabel})을 깊이 공감해주고, 부드러운 어머니의 말투로 답하세요.
      글자가 크게 보일 것이니 문장은 짧고 간결하게, 하지만 사랑을 듬뿍 담아 작성하세요.
      반드시 다음 JSON 구조로만 답하세요:
      {
        "comfort": "따뜻한 위로 (2~3문장)",
        "advice": "다정한 지혜와 조언 (1~2문장)",
        "mission": "내일의 행복 미션 (재미있게)",
        "quote": "한 줄 명언"
      }
    `;

    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: content }] }],
          systemInstruction: { parts: [{ text: systemInstruction }] },
          generationConfig: { responseMimeType: "application/json" }
        })
      });

      if (!response.ok) throw new Error("API failed");
      const result = await response.json();
      const resultData = JSON.parse(result.candidates[0].content.parts[0].text);

      if (user) {
        const entryData = {
          content,
          response: resultData,
          emotionId: selectedEmotion,
          timestamp: { seconds: Math.floor(Date.now() / 1000) }
        };
        const docRef = await addDoc(collection(db, 'artifacts', appId, 'users', user.uid, 'diary_entries'), entryData);
        setCurrentEntry({ id: docRef.id, ...entryData });
        setView('detail');
      }
    } catch (err) {
      setError("등불이 깜빡거려요. 잠시 후에 다시 써볼까요?");
    } finally {
      setIsGenerating(false);
      setDiaryText('');
    }
  };

  const deleteEntry = async (id) => {
    if (!window.confirm("정말 이 추억 등불을 끌까요? 지우면 다시 볼 수 없어요.")) return;
    try {
      await deleteDoc(doc(db, 'artifacts', appId, 'users', user.uid, 'diary_entries', id));
      setView('history');
    } catch (err) {
      setError("추억을 지우지 못했어요.");
    }
  };

  const getEmotion = (id) => EMOTIONS.find(e => e.id === id) || EMOTIONS[0];

  return (
    <div className="min-h-screen bg-[#FFFDF9] text-slate-800 font-sans p-2 md:p-6 lg:p-8 flex items-center justify-center">
      {/* 화면 가득 차는 모달 스타일 레이아웃 (max-w-5xl) */}
      <div className="w-full max-w-5xl bg-white rounded-[3rem] shadow-2xl overflow-hidden border-4 border-orange-50 flex flex-col h-[95vh]">
        
        {/* Header - 제목 대폭 확대 (text-6xl) */}
        <header className="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 p-8 text-white text-center relative shrink-0">
          <div className="flex justify-center mb-2">
            <div className="p-2 bg-white/20 rounded-full backdrop-blur-md animate-bounce">
              <Sparkles className="w-12 h-12 text-yellow-200 fill-yellow-200" />
            </div>
          </div>
          <h1 className="text-6xl font-black tracking-tight drop-shadow-xl mb-3">비밀일기장</h1>
          <p className="text-white/90 text-xl font-bold italic">지혜로 피어나는 등불, 소중한 추억이 머무는 비밀 저장소</p>
          
          {view !== 'write' && (
            <button 
              onClick={() => setView('write')}
              className="absolute left-8 top-1/2 -translate-y-1/2 p-3 hover:bg-white/10 rounded-full transition-colors"
            >
              <ArrowLeft className="w-10 h-10" />
            </button>
          )}
        </header>

        {/* Navigation - 탭 텍스트 확대 */}
        <nav className="flex bg-slate-50 border-b-4 border-slate-100 shrink-0">
          <button 
            onClick={() => setView('write')}
            className={`flex-1 py-6 text-2xl font-black flex items-center justify-center gap-3 transition-all ${view === 'write' ? 'text-indigo-600 bg-white border-b-4 border-indigo-600 shadow-inner' : 'text-slate-400 hover:bg-white/50'}`}
          >
            <BookOpen className="w-8 h-8" /> 마음 적기
          </button>
          <button 
            onClick={() => setView('history')}
            className={`flex-1 py-6 text-2xl font-black flex items-center justify-center gap-3 transition-all ${view === 'history' || view === 'detail' ? 'text-indigo-600 bg-white border-b-4 border-indigo-600 shadow-inner' : 'text-slate-400 hover:bg-white/50'}`}
          >
            <History className="w-8 h-8" /> 추억 저장소
          </button>
        </nav>

        {/* Main Content Area */}
        <main className="flex-1 overflow-y-auto p-8 lg:p-12 custom-scrollbar relative bg-[url('https://www.transparenttextures.com/patterns/notebook.png')] bg-repeat">
          {error && (
            <div className="mb-6 p-6 bg-red-50 text-red-600 rounded-3xl text-xl font-bold border-2 border-red-100 flex items-center gap-3 animate-pulse">
              <ShieldCheck className="w-8 h-8" /> {error}
            </div>
          )}

          {view === 'write' && (
            <div className="space-y-6 animate-in fade-in duration-500 h-full flex flex-col">
              {/* 텍스트 입력창 - 주인공이므로 가장 크게 (text-4xl) */}
              <div className="relative flex-1">
                <textarea 
                  value={diaryText}
                  onChange={(e) => setDiaryText(e.target.value)}
                  placeholder="오늘 어떤 일이 있었니? 이곳은 오직 너와 마음 등불만 아는 비밀 공간이야. 솔직하게 적어봐..."
                  className="w-full h-full min-h-[300px] p-12 rounded-[3rem] bg-white border-4 border-slate-100 focus:border-indigo-300 transition-all outline-none resize-none leading-relaxed text-4xl font-medium text-slate-700 shadow-inner"
                />
                <div className="absolute bottom-10 right-12 text-slate-300 text-xl font-black">
                  {diaryText.length}자의 진심
                </div>
              </div>

              {/* 스티커 선택 영역 - 하단 버튼 바로 위, 한 줄 8개 배치 */}
              <div className="bg-white/90 backdrop-blur-sm p-5 rounded-[2.5rem] border-2 border-indigo-100 shadow-sm">
                <div className="flex items-center justify-center gap-3 text-indigo-600 mb-4 font-black text-xl">
                  <Palette className="w-5 h-5" /> 오늘의 마음 스티커 골라주기
                </div>
                <div className="grid grid-cols-8 gap-2 px-2">
                  {EMOTIONS.map(e => (
                    <button
                      key={e.id}
                      onClick={() => setSelectedEmotion(e.id)}
                      className={`p-2 rounded-2xl transition-all flex flex-col items-center gap-1 border-2 group hover:scale-110 active:scale-125 ${selectedEmotion === e.id ? `${e.color} border-indigo-400 shadow-lg scale-110` : 'bg-white border-slate-50 hover:border-slate-200'}`}
                    >
                      <span className="text-4xl transform group-active:rotate-12 transition-transform">{e.emoji}</span>
                      <span className={`text-[10px] font-black leading-none ${selectedEmotion === e.id ? e.text : 'text-slate-400'}`}>{e.label}</span>
                    </button>
                  ))}
                </div>
              </div>

              <button 
                onClick={() => generateResponse(diaryText)}
                disabled={isGenerating || !diaryText.trim()}
                className={`w-full py-10 rounded-[3rem] flex items-center justify-center gap-4 text-white font-black text-4xl shadow-2xl transition-all transform active:scale-95 ${isGenerating ? 'bg-slate-300' : 'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-200'}`}
              >
                {isGenerating ? (
                  <>
                    <div className="w-12 h-12 border-8 border-white/30 border-t-white rounded-full animate-spin" />
                    <span>등불을 켜고 있어...</span>
                  </>
                ) : (
                  <>
                    <Send className="w-10 h-10" /> 일기 저장하고 등불 켜기
                  </>
                )}
              </button>
            </div>
          )}

          {view === 'history' && (
            <div className="grid grid-cols-1 gap-8 animate-in fade-in slide-in-from-right-8 duration-500 pb-12">
              {entries.length === 0 ? (
                <div className="text-center py-40 text-slate-400">
                  <div className="w-40 h-40 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-8 border-4 border-slate-100">
                    <History className="w-20 h-20 opacity-20" />
                  </div>
                  <p className="font-black text-4xl">아직 서랍이 비어있어!</p>
                  <p className="text-2xl mt-4 font-bold">네 이야기를 들려주면 등불이 켜질 거야.</p>
                </div>
              ) : (
                entries.map((item) => {
                  const emotion = getEmotion(item.emotionId);
                  return (
                    <div 
                      key={item.id} 
                      onClick={() => { setCurrentEntry(item); setView('detail'); }}
                      className="bg-white border-4 border-slate-50 p-10 rounded-[3.5rem] hover:border-indigo-200 hover:shadow-2xl transition-all cursor-pointer group relative overflow-hidden"
                    >
                      <div className="flex justify-between items-center mb-8">
                        <div className="flex items-center gap-6">
                          <div className={`w-24 h-24 ${emotion.color} rounded-[2rem] flex items-center justify-center text-5xl shadow-sm transform group-hover:rotate-6 transition-transform`}>
                            {emotion.emoji}
                          </div>
                          <div>
                            <span className="text-xl font-black text-slate-400 block mb-1">
                              {item.timestamp?.seconds ? new Date(item.timestamp.seconds * 1000).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' }) : '방금 전'}
                            </span>
                            <span className={`text-2xl font-black ${emotion.text}`}>#{emotion.label}</span>
                          </div>
                        </div>
                        <ChevronRight className="w-12 h-12 text-slate-300 group-hover:text-indigo-400 transform group-hover:translate-x-3 transition-all" />
                      </div>
                      <p className="text-slate-700 font-bold text-3xl line-clamp-2 leading-relaxed">
                        {item.content}
                      </p>
                    </div>
                  );
                })
              )}
            </div>
          )}

          {view === 'detail' && currentEntry && (
            <div className="space-y-12 animate-in zoom-in-95 duration-500 pb-12">
              {/* User Content */}
              <div className="bg-white p-12 rounded-[4rem] border-4 border-slate-50 shadow-lg relative">
                <div className="absolute -top-6 left-16 bg-white border-2 border-indigo-100 px-8 py-3 rounded-full text-xl font-black text-indigo-600 flex items-center gap-4 shadow-md">
                  <span className="text-3xl">{getEmotion(currentEntry.emotionId).emoji}</span> 나의 일기
                </div>
                <button 
                  onClick={() => deleteEntry(currentEntry.id)}
                  className="absolute top-10 right-12 p-3 text-slate-200 hover:text-red-400 transition-colors"
                >
                  <Trash2 className="w-10 h-10" />
                </button>
                <p className="text-slate-700 leading-[1.6] font-bold text-4xl whitespace-pre-wrap pt-6">
                  {currentEntry.content}
                </p>
                <div className="mt-10 text-xl text-slate-300 font-black text-right">
                  {new Date(currentEntry.timestamp.seconds * 1000).toLocaleString('ko-KR')} 기록함
                </div>
              </div>

              {/* AI Response */}
              <div className="bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 p-12 rounded-[4rem] border-4 border-indigo-100 shadow-xl">
                <div className="flex items-center gap-4 text-indigo-700 mb-10 font-black text-4xl">
                  <Sparkles className="w-10 h-10 fill-indigo-200 text-indigo-400" /> 등불의 따뜻한 조언
                </div>
                
                <div className="space-y-12">
                  <section>
                    <h4 className="text-base font-black text-indigo-400 uppercase tracking-[0.4em] mb-4">따뜻한 토닥임</h4>
                    <p className="text-slate-800 text-3xl leading-relaxed italic font-bold">"{currentEntry.response.comfort}"</p>
                  </section>
                  
                  <section className="bg-white/70 backdrop-blur-sm p-10 rounded-[3rem] border-2 border-white shadow-sm">
                    <h4 className="text-base font-black text-purple-400 uppercase tracking-[0.4em] mb-4">등불의 지혜</h4>
                    <p className="text-slate-800 text-3xl leading-relaxed font-bold">{currentEntry.response.advice}</p>
                  </section>

                  <section className="bg-indigo-600 text-white p-10 rounded-[3rem] shadow-2xl transform hover:rotate-1 transition-transform">
                    <h4 className="text-sm font-black text-indigo-200 uppercase mb-3 tracking-widest text-center">행복한 내일 미션</h4>
                    <p className="text-5xl font-black leading-tight text-center">🚀 {currentEntry.response.mission}</p>
                  </section>

                  <div className="text-center pt-6 italic text-slate-400 text-2xl font-bold border-t-4 border-indigo-100/50">
                    "{currentEntry.response.quote}"
                  </div>
                </div>
              </div>

              <button 
                onClick={() => setView('history')}
                className="w-full py-8 rounded-[2.5rem] bg-slate-100 text-slate-500 font-black hover:bg-slate-200 transition-colors text-3xl"
              >
                추억 서랍으로 돌아가기
              </button>
            </div>
          )}
        </main>

        {/* Footer */}
        <footer className="p-8 bg-white border-t-4 border-slate-50 text-center shrink-0">
          <p className="text-2xl text-slate-300 font-black flex items-center justify-center gap-3">
            <ShieldCheck className="w-6 h-6" /> 등불처럼 환한 너의 미래를 언제나 응원할게!
          </p>
        </footer>
      </div>

      <style dangerouslySetInnerHTML={{ __html: `
        .custom-scrollbar::-webkit-scrollbar { width: 10px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 20px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }
        
        body {
          background-image: 
            radial-gradient(#e2e8f0 3px, transparent 3px),
            radial-gradient(#e2e8f0 3px, transparent 3px);
          background-size: 50px 50px;
          background-position: 0 0, 25px 25px;
        }

        @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slide-in-right { from { transform: translateX(50px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        @keyframes zoom-in { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }

        .animate-in { animation-fill-mode: forwards; }
        .fade-in { animation-name: fade-in; }
        .slide-in-from-right-8 { animation-name: slide-in-right; }
        .zoom-in-95 { animation-name: zoom-in; }
      `}} />
    </div>
  );
};

export default App;